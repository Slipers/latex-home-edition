{
  "name": "molecularchemistry-edition",
  "productName": "LaTeX MolecularChemistry Edition",
  "version": "1.0.0",
  "description": "Modélisation moléculaire 3D et entraînement en chimie (programme de PCSI)",
  "author": "Slipers",
  "license": "MIT",
  "homepage": "https://github.com/Slipers/latex-home-edition/tree/main/molecular",
  "repository": {
    "type": "git",
    "url": "https://github.com/Slipers/latex-home-edition.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js",
    "version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.slipers.molecularchemistry",
    "productName": "LaTeX MolecularChemistry Edition",
    "copyright": "LaTeX MolecularChemistry Edition — MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!scripts/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "MolecularChemistry-Edition-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MolecularChemistry Edition",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "lmc",
        "name": "Molécule MolecularChemistry Edition",
        "description": "Molécule MolecularChemistry Edition",
        "role": "Editor"
      }
    ],
    "generateUpdatesFilesForAllChannels": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Slipers/latex-home-edition/releases/download/molecular-latest",
        "channel": "molecular"
      }
    ]
  }
}
